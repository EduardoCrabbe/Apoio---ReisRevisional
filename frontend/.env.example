# URL base da API do backend. Vazio = mesma origem (útil quando empacotado).
# Em desenvolvimento o backend sobe em http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000

# Credenciais de conveniência para os botões "Entrar como ..." na tela de login
# (para o apresentador não digitar senha no palco). Devem existir no banco —
# rode `python backend/demo_seed.py` para criá-las.
VITE_DEMO_GERENTE_EMAIL=gerente@reisrevisional.com.br
VITE_DEMO_GERENTE_SENHA=demo1234
VITE_DEMO_CS_EMAIL=cs@reisrevisional.com.br
VITE_DEMO_CS_SENHA=demo1234
