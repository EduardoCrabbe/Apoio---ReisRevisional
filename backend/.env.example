# ============================================================
# Apoio ao CS — Backend (FastAPI)
# Modelo de variáveis de ambiente. Copie para `.env` e preencha.
#   cp .env.example .env
# O arquivo `.env` real NUNCA deve ser versionado (ver .gitignore).
# ============================================================

# Chave secreta para assinatura/validação dos tokens JWT de sessão.
# Use um valor longo e aleatório (ex.: `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# Trocar esta chave invalida todos os tokens já emitidos (logout global).
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Chave da API do Google Gemini, usada por gemini_service.py para gerar
# os resumos em 1ª pessoa dos atendimentos (POST /api/ai/summarize).
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-do-gemini-aqui

# String de conexão do banco usada pelo SQLAlchemy (database.py).
# Padrão: SQLite local embutido na pasta do backend.
# Formato SQLite:   sqlite:///./database.db
# Ex.: PostgreSQL:  postgresql+psycopg2://usuario:senha@host:5432/apoio_cs
DATABASE_URL=sqlite:///./database.db
